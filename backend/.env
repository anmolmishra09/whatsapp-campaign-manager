# ==============================================================================
# Redis & BullMQ Queue Configuration
# Note: Leave REDIS_PASSWORD empty if running standard local Redis without auth
# ==============================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
QUEUE_CONCURRENCY=5
QUEUE_RATE_MAX=40
QUEUE_RATE_DURATION_MS=1000

# ==============================================================================
# Meta WhatsApp Business Platform Cloud API
# Replace placeholders with live credentials from developers.facebook.com
# ==============================================================================
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_ACCESS_TOKEN=EAAB...your_actual_token_here
WHATSAPP_PHONE_NUMBER_ID=your_actual_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_actual_waba_id_here
WHATSAPP_VERIFY_TOKEN=campaign_webhook_verify_token_2026
WHATSAPP_APP_SECRET=your_app_secret_here
