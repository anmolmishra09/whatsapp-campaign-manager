ALLOWED_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

# ==============================================================================
# PostgreSQL Configuration (Local Windows Instance)
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=wa_admin
DB_PASSWORD=5911
DB_NAME=wa_campaigns_db
